# Discord bot token
DISCORD_BOT_TOKEN=your_bot_token_here
# Or reuse an existing name:
# LEVELS_BOT_TOKEN=your_bot_token_here

# Optional — set after !setupstats or create channels manually
# GUILD_ID=your_server_id
# MEMBER_STATS_CHANNEL_ID=voice_channel_id
# CLOCK_STATS_CHANNEL_ID=voice_channel_id

# Clock timezone (default: Morocco)
# STATS_TIMEZONE=Africa/Casablanca
# STATS_TIME_LABEL=Morocco

# Voice lounge (bot stays here when online)
# BOT_VOICE_CHANNEL_ID=1518025649225470072
